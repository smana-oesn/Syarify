/* Pola ukiran halus transparan untuk background utama */
.hero {
  position: relative;
  overflow: hidden;
  background-color: #f7f4ed !important; /* Warna cream estetik */
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: url('https://transparenttextures.com');
  background-repeat: repeat;
  opacity: 0.06; /* Mengatur ketebalan ukiran agar samar dan elegan */
  pointer-events: none;
}

/* Ornamen pojok kanan bawah khusus kartu/elemen utama */
.challenge-card {
  position: relative;
  overflow: hidden;
}

.challenge-card::after {
  content: "✦";
  position: absolute;
  bottom: 8px;
  right: 12px;
  font-size: 20px;
  color: #c5a880; /* Warna emas syariah melambangkan bintang ornamen */
  opacity: 0.5;
}
